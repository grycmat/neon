<?xml version="1.0" encoding="utf-8"?>
<!-- Widget substrate, dark: the app's bg→bg2 wash, held just short of opaque so a little
     wallpaper reads through the glass. Corners are baked in because GlanceModifier.cornerRadius
     needs API 31 and this ships to minSdk 26. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:endColor="#F20A0813"
        android:startColor="#F2140F26"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
